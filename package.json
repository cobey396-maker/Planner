    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^29.1.1",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.10.0",
