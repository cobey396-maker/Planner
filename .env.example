# Copy to .env.local for local development. Never commit real values.
# Where to find each value: see DATABASE.md.

# Public URL of the app (used for share links and metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3002

# --- Database (Phase 2) -------------------------------------------------------
# Pooled connection for the running app (Supabase "Transaction pooler", port 6543).
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres"
# Connection for migrations (Supabase "Session pooler", port 5432).
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# --- Accounts (Phase 3) -------------------------------------------------------
# Both are PUBLIC (they ship to the browser; row-level security protects data).
# Supabase: Project Settings > API Keys. Leave empty to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) ---------------
# Supabase: Project Settings > API Keys > "Secret keys". Used only by the
# notifications cron job. Leave empty locally if you don't need emails.
SUPABASE_SECRET_KEY=""
# Email notifications via Resend (resend.com > API Keys) and a sender address
# on a domain you verified there, e.g. "Auto-Planner <reminders@yourdomain.com>".
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL=""
# Any long random string; the cron caller must send "Authorization: Bearer <it>".
CRON_SECRET=""
